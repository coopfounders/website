# ---- Provider API keys (server-side only; never shipped to the client) ----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ---- Access gate ----
# The password required to use /gpt. Set this to the real password before deploying.
GPT_ACCESS_PASSWORD=change-me
# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-hex-string

# ---- Monthly budget caps (USD). Requests to a provider are blocked once its
# ---- calendar-month spend reaches the cap. Leave unset for no cap.
ANTHROPIC_MONTHLY_CAP_USD=25
OPENAI_MONTHLY_CAP_USD=25

# ---- Rate limiting / abuse protection ----
# Per-IP chat requests allowed per window.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SEC=300
# Global backstop: total chat requests allowed per UTC day across all users.
GLOBAL_DAILY_REQUEST_CAP=500
# Maximum characters in a single user message.
MAX_INPUT_CHARS=32000

# ---- Database (Postgres) ----
# Create a free database at https://neon.tech (or use the Neon integration in
# the Vercel dashboard) and paste its pooled connection string here. The same
# URL works for local dev and production.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---- Server ----
PORT=8790
# Public origin of the site, used for Origin checking on mutating requests.
# Example: https://cooplabs.com
SITE_ORIGIN=
