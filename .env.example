# Copy to .env for local development. Keep real values out of source control.
# Resend API key with sending permission for the verified sender domain.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. Coop Website <website@cooplabs.com>
RESEND_FROM=founders@cooplabs.com
# Inbox that receives inquiries. Reply goes directly to the visitor.
RESEND_TO=founders@cooplabs.com
