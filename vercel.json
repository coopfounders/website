{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/static",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/gpt/usage", "destination": "/gpt/index.html" },
    { "source": "/gpt/context", "destination": "/gpt/index.html" }
  ]
}
